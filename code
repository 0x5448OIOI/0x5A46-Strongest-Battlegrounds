local fpsMedio, ultQuadro = 60, os.clock()
RunService.RenderStepped:Connect(function(dt)
    if dt > 0 then
        -- media que se move devagar, pra um travo nao virar panico
        fpsMedio = fpsMedio * 0.9 + (1 / dt) * 0.1
    end
end)

local function pingSegundos()
    local v = LP:GetAttribute("Ping")
    if type(v) == "number" and v > 0 then return v / 1000 end
    local ok, ms = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(ms) == "number" and ms > 0 then return ms / 1000 end
    return 0.05
end

-- quanto de folga a conexao e o computador desta pessoa exigem
local function folga()
    if not CFG.Compensar then return 0 end
    local porQuadro = 1 / math.max(10, fpsMedio)
    local f = pingSegundos() + porQuadro * 2
    return math.min(f, CFG.CompensarTeto)
end

-- O modo de compensacao so vale a pena pra quem realmente esta
-- atrasado. Com ping baixo e fps alto ele fica desligado sozinho, e o
-- auto block segue reativo e discreto como voce afinou.
local function atrasadoDemais()
    return CFG.Compensar and folga() >= CFG.CompensarLimite
end

-- ele esta virado pra mim?
local function viradoPraMim(hrp, meuHrp)
    local para = (meuHrp.Position - hrp.Position)
    if para.Magnitude < 0.1 then return true end
    return hrp.CFrame.LookVector:Dot(para.Unit) > CFG.BlockMira
end

--==================================================================
-- AUTO BLOCK
--==================================================================
-- MUDANCA 1: nada de loop. Antes eu olhava os atributos a cada 0.03s,
-- o que e ate 30ms de atraso so pra PERCEBER, antes de qualquer outra
-- coisa. Agora uso AttributeChanged, que avisa no instante em que o
-- valor muda.
--
-- MUDANCA 2: o @HoldingM1 volta, mas usado direito. Ler o VALOR dele
-- continuamente prendia a guarda, porque ele fica verdadeiro o tempo
-- todo enquanto o cara segura. Ler a MUDANCA dele (falso -> verdadeiro)
-- e um evento discreto, e chega ANTES do soco sair. E isso que pega
-- os M1 que estavam passando.
--
-- MUDANCA 3: o script anota o que aconteceu do lado do inimigo nos
-- 0.8s antes de voce levar dano. Se algum atributo aparecer sempre
-- nessa janela e nao estiver na lista de gatilhos, e ele que esta
-- deixando passar. Da pra ler com:
--
--     getgenv().__TSB_APRENDIZADO
local bloqueadoAte = 0

-- O Humanoid gira o boneco sozinho quando AutoRotate esta ligado. Eu
-- escrevo o CFrame pra virar voce e ele escreve por cima no mesmo
-- quadro: cabo de guerra, que na tela parece "demora pra virar".
-- Enquanto a guarda estiver de pe eu desligo o AutoRotate e devolvo
-- exatamente como estava depois.
local autoRotateOriginal = nil

local function devolverAutoRotate()
    if autoRotateOriginal ~= nil then
        local _, _, hum = meuChar()
        if hum then pcall(function() hum.AutoRotate = autoRotateOriginal end) end
        autoRotateOriginal = nil
    end
end

local function soltarBloqueio()
    if segurandoF then
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        segurandoF = false
    end
    devolverAutoRotate()
end
ENV_solta = soltarBloqueio
ENV.__TSB_RESTAURAR = function()
    soltarBloqueio()
    devolverAutoRotate()
end

-- ==================================================================
-- QUANDO EU NAO QUERO SER BLOQUEADO
-- ==================================================================
-- Se eu aperto 1, 2, 3 ou 4 e a guarda sobe junto, a skill morre no
-- nascimento. Entao a minha propria tecla cala o auto block por um
-- tempo, e solta a guarda na hora se ela estiver de pe.
local pausaAte = 0

local function estouNoAr()
    local _, _, hum = meuChar()
    if not hum then return false end
    local st = hum:GetState()
    return st == Enum.HumanoidStateType.Freefall
        or st == Enum.HumanoidStateType.Jumping
        or st == Enum.HumanoidStateType.Landed
end

-- ==================================================================
-- VIRAR PRA QUEM BATE
-- ==================================================================
-- So o eixo Y: se eu copiasse a inclinacao tambem, voce ficaria
-- olhando pro chao ou pro ceu quando o cara estivesse em altura
-- diferente, e ai a guarda erra do mesmo jeito.
local function virarPara(hrp)
    if not CFG.Virar then return end
    local c, meuHrp = meuChar()
    if not (c and meuHrp and hrp) then return end

    local mira = Vector3.new(hrp.Position.X, meuHrp.Position.Y, hrp.Position.Z)
    if (mira - meuHrp.Position).Magnitude < 0.2 then return end

    if CFG.VirarCorpo then
        local destino = CFrame.new(meuHrp.Position, mira)
        if CFG.VirarSuave > 0 then
            local t0, de = os.clock(), meuHrp.CFrame
            task.spawn(function()
                while souAtual() and os.clock() - t0 < CFG.VirarSuave do
                    local a = (os.clock() - t0) / CFG.VirarSuave
                    pcall(function() meuHrp.CFrame = de:Lerp(destino, a) end)
                    task.wait()
                end
                pcall(function() meuHrp.CFrame = destino end)
            end)
        else
            pcall(function() meuHrp.CFrame = destino end)
        end
    end

end

-- quem eu estou defendendo agora, pra continuar virado nele
local agressorAtual

local function pedirBloqueio(motivo, hrpAgressor, segurar)
    local agora = os.clock()
    if agora < pausaAte then stat.recusas.calado = stat.recusas.calado + 1 return end
    if CFG.BlockNaoNoAr and estouNoAr() then
        stat.recusas.ar = stat.recusas.ar + 1
        return
    end
    if not segurandoF then
        segurandoF = true
        stat.ultimoBloq = agora
        stat.bloqueios = stat.bloqueios + 1
        -- tira o Humanoid da disputa ANTES de virar
        if CFG.Virar and CFG.VirarCorpo and autoRotateOriginal == nil then
            local _, _, hum = meuChar()
            if hum then
                autoRotateOriginal = hum.AutoRotate
                pcall(function() hum.AutoRotate = false end)
            end
        end
        pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
    end
    -- a guarda fica de pe pelo tempo pedido MAIS o atraso desta pessoa
    local ate = agora + (segurar or CFG.BlockSegurar) + folga()
    if ate > bloqueadoAte then bloqueadoAte = ate end
    local teto = stat.ultimoBloq + CFG.BlockMaxSeguido
    if bloqueadoAte > teto then bloqueadoAte = teto end
    stat.motivo = motivo
    if hrpAgressor then
        agressorAtual = hrpAgressor
        virarPara(hrpAgressor)
    end
end

-- ELE GIRA, EU GIRO JUNTO
-- Virar uma vez na hora do bloqueio nao basta: o cara circula em
-- volta e a guarda, que so protege a frente, fica olhando pro vazio.
--
-- E vai no Heartbeat, nao no RenderStepped: o RenderStepped roda ANTES
-- da fisica, entao a rotacao do personagem acontecia depois e apagava
-- a minha. No Heartbeat eu escrevo por ultimo e fica.
RunService.Heartbeat:Connect(function()
    if not souAtual() then return end
    if segurandoF and CFG.Virar and CFG.VirarCorpo
       and agressorAtual and agressorAtual.Parent then
        virarPara(agressorAtual)
    end
end)

-- quem solta a guarda
-- Heartbeat em vez de task.wait: com fps baixo o wait nao acorda mais
-- rapido que um quadro de qualquer jeito, e assim eu nao pago espera
-- em cima da espera.
RunService.Heartbeat:Connect(function()
    if not souAtual() then return end
    if segurandoF and (os.clock() >= bloqueadoAte or not CFG.Block) then
        soltarBloqueio()
    end
end)

-- CONFERE SE A GUARDA SUBIU MESMO
-- Eu so mandava o F quando achava que a guarda estava baixa. Se ela
-- caisse no jogo sem eu saber - guarda quebrada, tecla perdida, o jogo
-- recusando naquele instante - a minha variavel continuava dizendo que
-- estava segurando e eu nunca reenviava.
--
-- O @Blocking do meu personagem e a verdade. Se ele diz falso enquanto
-- eu deveria estar bloqueando, eu aperto de novo.
task.spawn(function()
    local ultimaTentativa = 0
    while souAtual() do
        task.wait(0.05)
        if segurandoF and os.clock() < bloqueadoAte
           and CFG.CompensarReenviar and atrasadoDemais() then
            local c = LP.Character
            if c and c:GetAttribute("Blocking") ~= true
               and os.clock() - ultimaTentativa > 0.12 then
                ultimaTentativa = os.clock()
                pcall(function()
                    VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                    VIM:SendKeyEvent(true,  Enum.KeyCode.F, false, game)
                end)
                stat.motivo = stat.motivo .. " · reenviei o F"
            end
        end
    end
end)

-- CARGA DE SKILL, POR BORDA E COM VALIDADE
-- Antes eu lia o VALOR do Holding<Skill> num laco. Se algum desses
-- atributos ficar verdadeiro parado - e tem varios assim - a guarda
-- renovava pra sempre so por existir gente por perto. Foi o mesmo
-- erro que eu ja tinha cometido com o HoldingM1.
--
-- Agora eu registro a BORDA (quando vira verdadeiro), guardo a hora,
-- e so mantenho a guarda enquanto aquela carga for recente. Skill
-- longa continua coberta porque a validade e generosa; atributo
-- travado nao segura nada, porque a borda dele ja passou faz tempo.
local cargas = {}   -- [char] = { [attr] = hora da borda }

local function marcarCarga(ch, nome, valor)
    cargas[ch] = cargas[ch] or {}
    if valor == true then
        cargas[ch][nome] = os.clock()
    else
        cargas[ch][nome] = nil
    end
end

task.spawn(function()
    while souAtual() do
        task.wait(0.04)
        if CFG.Block and CFG.BlockSkill then
            local _, meuHrp = meuChar()
            if meuHrp and os.clock() >= pausaAte then
                for _, e in ipairs(inimigos(CFG.BlockSkillAlcance)) do
                    local reg = cargas[e.char]
                    if reg then
                        for nome, quando in pairs(reg) do
                            local longe = e.d > CFG.BlockAlcance
                            local mirando = (not longe)
                                or (e.hrp.CFrame.LookVector:Dot(
                                    (meuHrp.Position - e.hrp.Position).Unit) > 0.2)
                            if mirando and os.clock() - quando <= CFG.BlockSkillValidade then
                                pedirBloqueio(
                                    string.format("%s · carregando %s",
                                        e.plr.Name, nome:sub(8)),
                                    e.hrp, CFG.BlockSkillCauda)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- GUARDA POR PROXIMIDADE
-- Com atraso alto, reagir nao ganha: quando o aviso chega, o soco ja
-- saiu. A saida e a guarda ja estar de pe antes de existir soco.
--
-- Isso liga sozinho, so quando a folga medida passa do limite. Quem
-- joga com 50ms e 60fps nunca ve isso acontecer; quem joga com 250ms
-- e 25fps passa a ter guarda de pe perto do inimigo, que e a unica
-- coisa que funciona nessa condicao.
--
-- O alcance cresce com o atraso: o cara corre ~16 studs/s, entao com
-- meio segundo de folga ele cobre 8 studs enquanto meu bloqueio viaja.
task.spawn(function()
    while souAtual() do
        task.wait(0.08)
        local porAtraso = CFG.CompensarPerto and atrasadoDemais()
        if CFG.Block and (CFG.BlockSempre or porAtraso) then
            local _, meuHrp = meuChar()
            if meuHrp and os.clock() >= pausaAte then
                local alcance = CFG.BlockSempre and CFG.BlockSempreAlcance
                    or (CFG.CompensarPertoAlcance + folga() * 16)
                local perto = inimigos(alcance)[1]
                if perto then
                    pedirBloqueio(string.format("%s · %s a %.0f",
                        porAtraso and "perto (atraso)" or "guarda sempre",
                        perto.plr.Name, perto.d), perto.hrp)
                end
            end
        end
    end
end)

-- ================== APRENDIZADO ==================
-- tudo que os inimigos por perto mexeram, com hora
local historico = {}
ENV.__TSB_APRENDIZADO = ENV.__TSB_APRENDIZADO or { antesDoDano = {}, danos = 0 }
local APR = ENV.__TSB_APRENDIZADO

local function anotar(nome)
    historico[#historico+1] = { t = os.clock(), attr = nome }
    -- so guarda os ultimos 2 segundos
    while #historico > 0 and os.clock() - historico[1].t > 2 do
        table.remove(historico, 1)
    end
end

local function aoLevarDano()
    APR.danos = APR.danos + 1
    local corte = os.clock() - 0.8
    local vistos = {}
    for _, h in ipairs(historico) do
        if h.t >= corte then vistos[h.attr] = true end
    end
    for nome in pairs(vistos) do
        APR.antesDoDano[nome] = (APR.antesDoDano[nome] or 0) + 1
    end
end

-- ================== GATILHOS ==================
-- Os atributos que apareceram antes dos 16 danos gravados, com o
-- aviso que cada um deu:
--
--     M1Cooldown   13/16   media 0.38s   <- o mais cedo
--     Combo        16/16   media 0.26s   <- cobertura total
--     ComboTimer   16/16   media 0.26s
--     LastM1Fire   15/16   media 0.22s
--     LastLastM1    8/16   media 0.22s
--     HoldingM1    15/16   media 0.11s
--
-- Usar so o LastM1Fire perdia um em dezesseis e chegava 0.16s mais
-- tarde que o M1Cooldown. Juntos dao 16/16 com a maior margem.
-- SO O QUE E ATAQUE DE VERDADE.
-- Combo e ComboTimer mudam sozinhos quando o combo expira, e
-- M1Cooldown quando o cooldown vira. Nenhum dos tres quer dizer "ele
-- bateu". Eram eles que faziam a guarda subir so por ter gente perto.
-- Ficam de fora, mesmo tendo dado o aviso mais cedo.
local GATILHO_M1 = {
    LastM1Fire = true, LastLastM1 = true,
}
-- SKILL: cada skill do jogo tem o proprio atributo Holding<Nome>, que
-- vira verdadeiro quando o cara comeca a usar. Visto nos teus dados:
--
--     HoldingPinpointCut   aviso 1.03s   disparado a 28 studs
--     HoldingCrowdBuster   aviso 0.83s
--     HoldingQuickSlice    aviso 0.79s
--
-- Entao nao preciso listar skill por skill de personagem por
-- personagem: qualquer atributo que comece com "Holding" e uma skill
-- sendo carregada. HoldingM1 e HoldingSpace ficam de fora porque sao
-- soco e pulo.
--
-- E skill vem de LONGE. 28 studs, contra 2 a 7 do M1. Por isso ela
-- tem alcance proprio, e uma guarda mais longa, porque demora a
-- chegar depois de anunciada.
-- LastReact dispara quando a pessoa LEVA um golpe, nao quando da.
-- Alguem apanhando perto de voce te fazia bloquear. Fora.
-- LastDashSwing e CanReactivateIC eram palpite meu e nunca apareceram
-- antes de dano nenhum nos dados. Fora tambem.
local GATILHO_SKILL = { LastSkill = true }

-- devolve: vale, rotulo, quanto segurar
local function ehGatilho(nome, valorNovo, dist)
    if CFG.BlockTudo and dist <= CFG.BlockAlcance then
        return true, "qualquer", CFG.BlockSegurar
    end

    -- Skill de longe SO conta se ele estiver mirando em voce. Quem
    -- lanca skill a 30 studs mira no alvo; se ele esta de lado, o alvo
    -- e outro. De perto isso nao vale, porque ai ele gira no meio.
    if CFG.BlockSkill and nome:sub(1, 7) == "Holding" and not HOLDING_IGNORAR[nome] then
        if valorNovo == true and dist <= CFG.BlockSkillAlcance then
            return true, nome:sub(8), CFG.BlockSkillSegurar, dist > CFG.BlockAlcance
        end
        return false
    end
    if GATILHO_SKILL[nome] and CFG.BlockSkill and dist <= CFG.BlockSkillAlcance then
        return true, "skill", CFG.BlockSkillSegurar
    end

    if GATILHO_M1[nome] and CFG.BlockM1 and dist <= CFG.BlockAlcance then
        return true, "M1", CFG.BlockSegurar
    end
    if nome == "HoldingM1" and CFG.BlockAntecipar and valorNovo == true then
        -- 16 studs/s e a corrida do TSB: com o atraso desta pessoa, ele
        -- percorre isso antes do meu bloqueio existir do lado de la
        if dist <= CFG.BlockAnteciparAlcance + folga() * 16 then
            return true, "puxou o M1", CFG.BlockSegurar
        end
        return false
    end
    return false
end

local ligados = setmetatable({}, { __mode = "k" })

local function vigiar(plr)
    local ch = plr.Character
    if not ch or ligados[ch] then return end
    ligados[ch] = true
    ch.AttributeChanged:Connect(function(nome)
        if not souAtual() then return end
        local _, meuHrp = meuChar()
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not (meuHrp and hrp) then return end
        local d = distEfetiva(hrp, meuHrp)
        anotar(nome)
        if not CFG.Block then return end
        -- corte grosso so pra nao pesar; cada gatilho tem alcance proprio
        if d > math.max(CFG.BlockAlcance, CFG.BlockSkillAlcance) then
            stat.recusas.longe = stat.recusas.longe + 1
            return
        end

        local valorAgora = ch:GetAttribute(nome)
        if nome:sub(1, 7) == "Holding" and not HOLDING_IGNORAR[nome] then
            marcarCarga(ch, nome, valorAgora)
        end

        local vale, rotulo, segurar, exigeMira = ehGatilho(nome, valorAgora, d)
        if not vale then
            stat.recusas.gatilho = stat.recusas.gatilho + 1
            return
        end
        -- direcao so pesa na antecipacao e em skill de longe, onde
        -- falso positivo custa caro. Em soco ja disparado, distancia
        -- sozinha decide.
        local precisaDirecao = exigeMira
                               or (not CFG.BlockMiraSoAntecipar)
                               or (rotulo == "puxou o M1")
        if precisaDirecao and not viradoPraMim(hrp, meuHrp) then
            stat.recusas.direcao = stat.recusas.direcao + 1
            return
        end
        pedirBloqueio(string.format("%s · %s a %.0f", plr.Name, rotulo, d), hrp, segurar)
    end)
end

local function acompanhar(plr)
    if plr == LP then return end
    vigiar(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if souAtual() then vigiar(plr) end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do acompanhar(p) end
Players.PlayerAdded:Connect(function(p) if souAtual() then acompanhar(p) end end)

-- as MINHAS teclas de skill calam o auto block
local MINHAS_TECLAS = {
    [Enum.KeyCode.One] = true, [Enum.KeyCode.Two] = true,
    [Enum.KeyCode.Three] = true, [Enum.KeyCode.Four] = true,
    [Enum.KeyCode.R] = true, [Enum.KeyCode.G] = true,   -- ult / extra
}
UIS.InputBegan:Connect(function(input, digitando)
    if digitando or not souAtual() then return end
    if MINHAS_TECLAS[input.KeyCode] then
        pausaAte = os.clock() + CFG.BlockPausaSkill
        bloqueadoAte = 0
        soltarBloqueio()
        stat.motivo = "calado: voce usou skill"
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        -- voce quer BATER. Guarda de pe cancela o soco, entao ela sai
        -- na hora e fica calada enquanto voce estiver socando. Cada
        -- clique renova; quando voce parar, ela volta sozinha.
        pausaAte = os.clock() + CFG.BlockPausaM1
        bloqueadoAte = 0
        soltarBloqueio()
        stat.motivo = "calado: voce esta batendo"
    end
end)

-- Rede de seguranca: se a MINHA acao saiu por qualquer caminho que nao
-- seja o teclado ou o mouse - botao de celular, outra tecla - os meus
-- proprios atributos denunciam, e eu calo do mesmo jeito.
task.spawn(function()
    local ultSkill, ultM1
    while souAtual() do
        task.wait(0.04)
        local c = LP.Character
        if c then
            local vs = c:GetAttribute("LastSkill")
            if vs and ultSkill and vs ~= ultSkill then
                pausaAte = os.clock() + CFG.BlockPausaSkill
                bloqueadoAte = 0
                soltarBloqueio()
                stat.motivo = "calado: skill saiu"
            end
            ultSkill = vs

            -- eu puxando meu proprio soco
            local vm = c:GetAttribute("HoldingM1")
            if vm == true and ultM1 ~= true then
                pausaAte = os.clock() + CFG.BlockPausaM1
                bloqueadoAte = 0
                soltarBloqueio()
                stat.motivo = "calado: voce esta batendo"
            end
            ultM1 = vm
        end
    end
end)

-- meu dano, pro aprendizado
local function ligarMeuDano(c)
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local vidaAnt = hum.Health
    hum.HealthChanged:Connect(function(v)
        if souAtual() and v < vidaAnt then aoLevarDano() end
        vidaAnt = v
    end)
end
if LP.Character then ligarMeuDano(LP.Character) end
LP.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    if souAtual() then ligarMeuDano(c) end
end)

