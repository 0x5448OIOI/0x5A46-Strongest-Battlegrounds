local function inimigos(alcance)
    local _, meuHrp = meuChar()
    if not meuHrp then return {} end
    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - meuHrp.Position).Magnitude
                if d <= alcance then
                    lista[#lista+1] = { plr = p, char = p.Character, hrp = hrp, d = d }
                end
            end
        end
    end
    table.sort(lista, function(a, b) return a.d < b.d end)
    return lista
end

-- DISTANCIA PREVISTA
-- O cara dando dash em cima de voce comeca o golpe longe e chega
-- perto. Se eu olho so a distancia de agora, ele e recusado no
-- instante do gatilho e acerta meio segundo depois. Entao desconto o
-- quanto ele vai andar na minha direcao no tempo de dianteira.
local function distEfetiva(hrp, meuHrp)
    local d = (hrp.Position - meuHrp.Position).Magnitude
    local para = meuHrp.Position - hrp.Position
    if para.Magnitude > 0.1 then
        local v = Vector3.zero
        pcall(function() v = hrp.AssemblyLinearVelocity end)
        local vindo = v:Dot(para.Unit)      -- studs/s na minha direcao
        if vindo > 0 then
            -- TETO. Sem isso, alguem correndo rapido numa briga a 30
            -- studs virava "13 studs" na conta e passava no filtro.
            -- A dianteira nunca pode comer mais que metade do que
            -- realmente separa voces dois.
            -- com ping alto ele anda mais durante o atraso, entao a
            -- dianteira cresce junto
            local dianteira = CFG.BlockPrever + folga()
            local desconto = math.min(vindo * dianteira, d * 0.5)
            d = d - desconto
        end
    end
    return math.max(0, d)
end

