--==================================================================
-- ESP
--==================================================================
-- Quatro coisas so: nome, estilo de luta, avatar em cima e caixa 3D.
--
-- O estilo vem do atributo @Character do personagem - o teu estava
-- como "Monster", e o jogador tem @Characters com a lista comprada.
local ESP = {
    On = false, Alcance = 500, Limite = 20,
    Nome = true, Estilo = true, Avatar = true, Caixa = true,
    Caixa2D = false, Esqueleto = false,
    NomeTam = 14, AvatarTam = 34,
    R = 255, G = 255, B = 255,
    -- onda de cor: nao e o arco-iris comum, que pinta tudo da mesma cor
    -- e vai trocando junto. Aqui o tom depende TAMBEM de onde a peca
    -- esta no desenho, entao a cor caminha pelo contorno.
    Onda = false, OndaVel = 0.35, OndaEspalha = 0.75,
}
do
    local ARQ_ESP = "tsb_esp.json"
    pcall(function()
        if readfile and isfile and isfile(ARQ_ESP) then
            local d = HttpService:JSONDecode(readfile(ARQ_ESP))
            if type(d) == "table" then
                for k, v in pairs(d) do
                    if ESP[k] ~= nil and type(ESP[k]) == type(v) then ESP[k] = v end
                end
            end
        end
    end)
    ESP.On = false
    local filaE = false
    local function salvarESP()
        if not writefile or filaE then return end
        filaE = true
        task.delay(1, function()
            filaE = false
            pcall(function() writefile(ARQ_ESP, HttpService:JSONEncode(ESP)) end)
        end)
    end

    local Camera = workspace.CurrentCamera
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if workspace.CurrentCamera then Camera = workspace.CurrentCamera end
    end)

    -- Drawing vive fora do jogo: sem apagar na mao vira lixo na tela
    if ENV.__TSBESP_LIXO then
        for _, d in ipairs(ENV.__TSBESP_LIXO) do pcall(function() d:Remove() end) end
    end
    ENV.__TSBESP_LIXO = {}
    local LIXO = ENV.__TSBESP_LIXO

    local temDrawing = (typeof(Drawing) == "table" or typeof(Drawing) == "userdata")
    local function novoDraw(tipo, props)
        if not temDrawing then return nil end
        local ok, d = pcall(function() return Drawing.new(tipo) end)
        if not ok or not d then return nil end
        for k, v in pairs(props or {}) do pcall(function() d[k] = v end) end
        LIXO[#LIXO+1] = d
        return d
    end

    local RAIZ = P.RAIZ
    local antiga = RAIZ:FindFirstChild("TSB_ESP_Avatares")
    if antiga then antiga:Destroy() end
    local telaAv = P.new("ScreenGui", { Name = "TSB_ESP_Avatares", ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = 900, Parent = RAIZ })

    local ARESTAS = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},
                      {1,5},{2,6},{3,7},{4,8} }

    local OSSOS_R15 = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
        {"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
        {"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
        {"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},
        {"RightLowerLeg","RightFoot"},
    }
    local OSSOS_R6 = {
        {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
        {"Torso","Left Leg"},{"Torso","Right Leg"},
    }

    -- A cor de cada peca depende do tempo E da posicao dela no desenho.
    -- E isso que faz a cor caminhar pelo contorno em vez de piscar tudo
    -- junto: a peca 1 esta num tom, a 2 um pouco adiante, e a onda anda.
    local function corDe(i, n)
        if not ESP.Onda then return Color3.fromRGB(ESP.R, ESP.G, ESP.B) end
        local passo = (i - 1) / math.max(1, n)
        local h = (os.clock() * ESP.OndaVel + passo * ESP.OndaEspalha) % 1
        return Color3.fromHSV(h, 0.8, 1)
    end

    -- pecas por JOGADOR, nunca por modelo: o personagem e destruido a
    -- cada morte, e recriar Drawing toda vez estoura o teto do executor
    local pecas = {}

    local function criarPecas()
        local p = { linhas = {}, quadro = {}, ossos = {} }
        for i = 1, 12 do p.linhas[i] = novoDraw("Line", { Thickness = 1, Visible = false }) end
        for i = 1, 4  do p.quadro[i] = novoDraw("Line", { Thickness = 1, Visible = false }) end
        for i = 1, 14 do p.ossos[i]  = novoDraw("Line", { Thickness = 1, Visible = false }) end
        p.nome   = novoDraw("Text", { Center = true, Outline = true, Size = 14, Visible = false })
        p.estilo = novoDraw("Text", { Center = true, Outline = true, Size = 12, Visible = false })
        p.avatar = P.new("ImageLabel", { Size = UDim2.fromOffset(34, 34),
            BackgroundTransparency = 1, Visible = false, Parent = telaAv })
        P.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = p.avatar })
        return p
    end

    local function esconder(p)
        if not p then return end
        for _, g in ipairs({ p.linhas, p.quadro, p.ossos }) do
            for _, l in ipairs(g) do if l then l.Visible = false end end
        end
        if p.nome then p.nome.Visible = false end
        if p.estilo then p.estilo.Visible = false end
        if p.avatar then p.avatar.Visible = false end
    end

    local function apagar(p)
        if not p then return end
        for _, g in ipairs({ p.linhas, p.quadro, p.ossos }) do
            for _, l in ipairs(g) do if l then pcall(function() l:Remove() end) end end
        end
        if p.nome then pcall(function() p.nome:Remove() end) end
        if p.estilo then pcall(function() p.estilo:Remove() end) end
        if p.avatar then pcall(function() p.avatar:Destroy() end) end
    end

    Players.PlayerRemoving:Connect(function(plr)
        if pecas[plr] then apagar(pecas[plr]) pecas[plr] = nil end
    end)

    local function proj(pos)
        local ok, sp = pcall(function() return Camera:WorldToViewportPoint(pos) end)
        if not ok or not sp or sp.Z <= 0 then return nil end
        return Vector2.new(sp.X, sp.Y)
    end

    -- ESP MAIS LEVE
    -- caixaLimpa percorre TODAS as pecas do personagem. Fazendo isso
    -- pra 20 jogadores a cada quadro sao milhares de iteracoes por
    -- segundo, e num computador fraco o proprio ESP derruba o fps que
    -- o auto block precisa. O tamanho de um boneco quase nao muda, so
    -- a posicao. Entao meco o tamanho de vez em quando e sigo a
    -- posicao todo quadro.
    local caixaCache = setmetatable({}, { __mode = "k" })
    local INTERVALO_CAIXA = 0.25

    -- caixa so com as pecas perto do tronco: peca solta longe estoura
    -- a caixa, que foi o que aconteceu no MM2 com a faca do assassino
    local function caixaLimpaBruta(m, hrp)
        local ctr = hrp.Position
        local mnx, mny, mnz =  math.huge,  math.huge,  math.huge
        local mxx, mxy, mxz = -math.huge, -math.huge, -math.huge
        local achou = false
        for _, pp in ipairs(m:GetDescendants()) do
            if pp:IsA("BasePart") and (pp.Position - ctr).Magnitude <= 14 then
                local cf, sz = pp.CFrame, pp.Size
                local rv, uv, lv = cf.RightVector, cf.UpVector, cf.LookVector
                local ex = math.abs(rv.X)*sz.X/2 + math.abs(uv.X)*sz.Y/2 + math.abs(lv.X)*sz.Z/2
                local ey = math.abs(rv.Y)*sz.X/2 + math.abs(uv.Y)*sz.Y/2 + math.abs(lv.Y)*sz.Z/2
                local ez = math.abs(rv.Z)*sz.X/2 + math.abs(uv.Z)*sz.Y/2 + math.abs(lv.Z)*sz.Z/2
                local o = pp.Position
                mnx = math.min(mnx, o.X-ex) mny = math.min(mny, o.Y-ey) mnz = math.min(mnz, o.Z-ez)
                mxx = math.max(mxx, o.X+ex) mxy = math.max(mxy, o.Y+ey) mxz = math.max(mxz, o.Z+ez)
                achou = true
            end
        end
        if not achou then return CFrame.new(ctr), Vector3.new(4, 6, 2), Vector3.zero end
        local centro = Vector3.new((mnx+mxx)/2, (mny+mxy)/2, (mnz+mxz)/2)
        return CFrame.new(centro), Vector3.new(mxx-mnx, mxy-mny, mxz-mnz), centro - ctr
    end

    local function caixaLimpa(m, hrp)
        local c = caixaCache[m]
        if not c or os.clock() - c.quando > INTERVALO_CAIXA then
            local _, tam, desvio = caixaLimpaBruta(m, hrp)
            c = { tam = tam, desvio = desvio, quando = os.clock() }
            caixaCache[m] = c
        end
        -- posicao sempre atual, tamanho reaproveitado
        return CFrame.new(hrp.Position + c.desvio), c.tam
    end

    RunService.RenderStepped:Connect(function()
        if not souAtual() then return end
        if not ESP.On then
            for _, p in pairs(pecas) do esconder(p) end
            return
        end
        local _, meuHrp = meuChar()
        if not meuHrp then return end
        local cor = Color3.fromRGB(ESP.R, ESP.G, ESP.B)

        local fila = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - meuHrp.Position).Magnitude
                    if d <= ESP.Alcance then
                        fila[#fila+1] = { plr = plr, ch = plr.Character, hrp = hrp, d = d }
                    end
                end
            end
        end
        table.sort(fila, function(a, b) return a.d < b.d end)

        local vistos = {}
        for i, alvo in ipairs(fila) do
            if i > ESP.Limite then break end
            vistos[alvo.plr] = true
            local pc = pecas[alvo.plr]
            if not pc then pc = criarPecas() pecas[alvo.plr] = pc end

            local cf, tam = caixaLimpa(alvo.ch, alvo.hrp)
            local hx, hy, hz = tam.X/2, tam.Y/2, tam.Z/2
            local c3d = {
                (cf*CFrame.new(-hx,-hy,-hz)).Position, (cf*CFrame.new( hx,-hy,-hz)).Position,
                (cf*CFrame.new( hx,-hy, hz)).Position, (cf*CFrame.new(-hx,-hy, hz)).Position,
                (cf*CFrame.new(-hx, hy,-hz)).Position, (cf*CFrame.new( hx, hy,-hz)).Position,
                (cf*CFrame.new( hx, hy, hz)).Position, (cf*CFrame.new(-hx, hy, hz)).Position,
            }
            local c2d, todos = {}, true
            for k, pos in ipairs(c3d) do
                c2d[k] = proj(pos)
                if not c2d[k] then todos = false end
            end

            local topo = proj(cf.Position + Vector3.new(0, hy, 0))
            if not topo then
                esconder(pc)
            else
                -- caixa 3D
                if ESP.Caixa then
                    for k, ar in ipairs(ARESTAS) do
                        local l = pc.linhas[k]
                        local a, b = c2d[ar[1]], c2d[ar[2]]
                        if l then
                            if a and b then
                                l.From, l.To = a, b
                                l.Color, l.Visible = corDe(k, #ARESTAS), true
                            else l.Visible = false end
                        end
                    end
                else
                    for _, l in ipairs(pc.linhas) do if l then l.Visible = false end end
                end

                -- caixa normal, so quando os 8 cantos estao na frente:
                -- com canto atras da camera o minimo/maximo estica
                if ESP.Caixa2D and todos then
                    local mnx, mny, mxx, mxy = math.huge, math.huge, -math.huge, -math.huge
                    for _, sp in ipairs(c2d) do
                        mnx = math.min(mnx, sp.X) mxx = math.max(mxx, sp.X)
                        mny = math.min(mny, sp.Y) mxy = math.max(mxy, sp.Y)
                    end
                    local pts = { Vector2.new(mnx,mny), Vector2.new(mxx,mny),
                                  Vector2.new(mxx,mxy), Vector2.new(mnx,mxy) }
                    for k = 1, 4 do
                        local l = pc.quadro[k]
                        if l then
                            l.From, l.To = pts[k], pts[k % 4 + 1]
                            l.Color, l.Visible = corDe(k, 4), true
                        end
                    end
                else
                    for _, l in ipairs(pc.quadro) do if l then l.Visible = false end end
                end

                -- esqueleto
                if ESP.Esqueleto then
                    local ossos = alvo.ch:FindFirstChild("UpperTorso")
                        and OSSOS_R15 or OSSOS_R6
                    for k = 1, #pc.ossos do
                        local l = pc.ossos[k]
                        local par = ossos[k]
                        if l then
                            if par then
                                local a = alvo.ch:FindFirstChild(par[1])
                                local b = alvo.ch:FindFirstChild(par[2])
                                local pa = a and proj(a.Position)
                                local pb = b and proj(b.Position)
                                if pa and pb then
                                    l.From, l.To = pa, pb
                                    l.Color, l.Visible = corDe(k, #ossos), true
                                else l.Visible = false end
                            else l.Visible = false end
                        end
                    end
                else
                    for _, l in ipairs(pc.ossos) do if l then l.Visible = false end end
                end

                local y = topo.Y
                -- avatar em cima de tudo
                if ESP.Avatar and pc.avatar then
                    local t = ESP.AvatarTam
                    pc.avatar.Size = UDim2.fromOffset(t, t)
                    pc.avatar.Position = UDim2.fromOffset(math.floor(topo.X - t/2),
                                                          math.floor(y - t - ESP.NomeTam - 24))
                    if pc.avatar.Image == "" then
                        pc.avatar.Image = "rbxthumb://type=AvatarHeadShot&id="
                            .. alvo.plr.UserId .. "&w=48&h=48"
                    end
                    pc.avatar.Visible = true
                    y = y - t - 30
                else
                    if pc.avatar then pc.avatar.Visible = false end
                end

                local alturaNome = ESP.NomeTam + 10
                if ESP.Nome and pc.nome then
                    pc.nome.Text = alvo.plr.Name
                    pc.nome.Size = ESP.NomeTam
                    pc.nome.Position = Vector2.new(topo.X, topo.Y - alturaNome - 12)
                    pc.nome.Color, pc.nome.Visible = corDe(1, 3), true
                else
                    if pc.nome then pc.nome.Visible = false end
                end

                if ESP.Estilo and pc.estilo then
                    local est = alvo.ch:GetAttribute("Character")
                    pc.estilo.Text = est and tostring(est) or "?"
                    pc.estilo.Size = math.max(9, ESP.NomeTam - 2)
                    pc.estilo.Position = Vector2.new(topo.X, topo.Y - 13)
                    pc.estilo.Color = ESP.Onda and corDe(2, 3)
                        or Color3.fromRGB(190, 190, 200)
                    pc.estilo.Visible = est ~= nil
                else
                    if pc.estilo then pc.estilo.Visible = false end
                end
            end
        end

        for plr, pc in pairs(pecas) do
            if not vistos[plr] then esconder(pc) end
        end
    end)

    local abaE = P.Tab("ESP", "◈")
    local g = abaE:Section("ESP", nil, 1)
    local function LigaE(section, o)
        return section:Toggle({ Name = o.Name, Default = ESP[o.Key],
            Keybind = o.Keybind,
            Callback = function(on) ESP[o.Key] = on salvarESP() end })
    end
    LigaE(g, { Key = "On", Name = "ESP", Keybind = { Key = Enum.KeyCode.K } })
    LigaE(g, { Key = "Nome", Name = "Nome do jogador" })
    LigaE(g, { Key = "Estilo", Name = "Estilo de luta" })
    LigaE(g, { Key = "Avatar", Name = "Avatar" })
    LigaE(g, { Key = "Caixa", Name = "Caixa 3D" })
    LigaE(g, { Key = "Caixa2D", Name = "Caixa normal" })
    LigaE(g, { Key = "Esqueleto", Name = "Esqueleto" })

    local function ReguaE(section, o)
        return section:Slider({ Name = o.Name, Min = o.Min, Max = o.Max,
            Default = ESP[o.Key], Decimals = o.Decimals or 0, Suffix = o.Suffix,
            Callback = function(v) ESP[o.Key] = v salvarESP() end })
    end

    local t = abaE:Section("Tamanho", nil, 2)
    ReguaE(t, { Key = "NomeTam", Name = "Tamanho do nome", Min = 9, Max = 26 })
    ReguaE(t, { Key = "AvatarTam", Name = "Tamanho do avatar", Min = 16, Max = 72 })

    local o = abaE:Section("Onda de cor", nil, 2)
    LigaE(o, { Key = "Onda", Name = "Onda de cor" })
    ReguaE(o, { Key = "OndaVel", Name = "Velocidade", Min = 0.05, Max = 2, Decimals = 2 })
    ReguaE(o, { Key = "OndaEspalha", Name = "Espalhamento", Min = 0.1, Max = 3, Decimals = 2 })

    if not temDrawing then
        P.notify("ESP", "Seu executor nao tem a biblioteca Drawing.", 8)
    end
end
end
