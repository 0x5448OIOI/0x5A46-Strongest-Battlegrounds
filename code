                    math.floor(fpsMedio), math.floor(pingSegundos() * 1000), folga(),
                    atrasadoDemais() and " · COMPENSANDO" or "",
                    perto and string.format("%s a %.0f · HoldingM1=%s",
                        perto.plr.Name, perto.d,
                        tostring(perto.char:GetAttribute("HoldingM1"))) or "ninguem",
                    stat.motivo, stat.bloqueios))
        end
    end
end)

